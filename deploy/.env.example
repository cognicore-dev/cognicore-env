# Copy to deploy/.env on the server and fill in. deploy/.env is gitignored:
# never commit it, and never paste these values into a chat or an issue.

# python -c "import secrets; print(secrets.token_urlsafe(48))"
COGNICORE_JWT_SECRET=

# GitHub OAuth App. Callback must be $COGNICORE_PUBLIC_URL/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

COGNICORE_PUBLIC_URL=https://mcp.cognicoree.tech
COGNICORE_DOMAIN=mcp.cognicoree.tech
COGNICORE_ACME_EMAIL=contact@cognicoree.tech

# Where the per-user databases live on the host. Point this at a mounted data
# disk, not the OS disk, so the data outlives the machine.
COGNICORE_HOST_DATA_DIR=/mnt/cognicore-data

# Optional
COGNICORE_EXTRA_REDIRECT_URIS=
COGNICORE_RATE_LIMIT_USER=120
COGNICORE_RATE_LIMIT_IP=120
COGNICORE_USE_SEMANTIC=0
